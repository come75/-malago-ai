{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "malago-villa-la-susana-route",
  // Path-only Worker: proxies the public La Susana path to its isolated static-assets Worker.
  "main": "worker.la-susana-route.js",
  "compatibility_date": "2026-09-25",
  "routes": [
    {
      "pattern": "malago-agency.com/partner/villasusana*",
      "zone_name": "malago-agency.com"
    }
  ]
}
