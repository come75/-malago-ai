{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "test",
  "main": "worker.js",
  "compatibility_date": "2026-09-25",
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "triggers": {"crons": ["0 * * * *"]},
  "cache": {"enabled": true},
  "ai": {"binding": "AI"},
  "assets": {"directory": "./public","binding": "ASSETS"},
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "malago-client-requests",
      "database_id": "573e7ef9-f5be-4ad2-b807-8c6c23661a33"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "malago-client-requests",
        "database_id": "573e7ef9-f5be-4ad2-b807-8c6c23661a33"
      }
    ],
    "ai": {"binding": "AI"},
    "assets": {"binding": "ASSETS"}
  }
}