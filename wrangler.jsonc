{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "malago-villamagos",
  "main": "worker.js",
  "compatibility_date": "2026-09-25",
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "cache": { "enabled": true },
  "ai": { "binding": "AI" },
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "malagoxvillamagos",
      "database_id": "ab0a3bc7-73e0-4548-8b7f-6314442b09a1"
    }
  ]
}