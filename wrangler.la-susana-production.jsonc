{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "malago-villa-la-susana",
  // Dedicated partner route; does not overlap Villa Magos path.
  "main": "worker.js",
  "routes": [
    {
      "pattern": "malago-agency.com/partner/villasusana*",
      "zone_name": "malago-agency.com"
    }
  ],
  "compatibility_date": "2026-09-25",
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "cache": { "enabled": true },
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "malago-villa-la-susana",
      "database_id": "9faaff50-7e47-4cd3-87ea-29d95706b926"
    }
  ]
}
